{
  "name": "chartermission",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@chartermission/web",
    "dev:admin": "turbo run dev --filter=@chartermission/admin",
    "dev:api": "turbo run dev --filter=@chartermission/api",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test"
  },
  "devDependencies": {
    "turbo": "^2.11.10",
    "typescript": "^5.9.3"
  }
}
