# Charter Mission MCP server (copy to apps/mcp/.env for local development).
PORT=4100
# Public address Claude connects to (no trailing slash). Locally: http://localhost:4100
PUBLIC_URL=http://localhost:4100
# The API as this server reaches it (internal network in production: http://cm-api:4000/api/v1).
API_INTERNAL_URL=http://localhost:4000/api/v1
# The member app (consent page /connect and links in tool results).
WEB_URL=http://localhost:3000
