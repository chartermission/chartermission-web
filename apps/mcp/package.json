{
  "name": "@chartermission/mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Charter Mission MCP server: lets a member connect Claude to their own account.",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@chartermission/contracts": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
