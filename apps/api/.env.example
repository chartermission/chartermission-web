NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://postgres@localhost:55432/chartermission
REDIS_URL=redis://localhost:56379

WEB_ORIGINS=http://localhost:3000,http://localhost:3001
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
API_PUBLIC_URL=http://localhost:3000/api/v1
# COOKIE_DOMAIN=

# Required in production. 32 random bytes, base64: openssl rand -base64 32
# APP_ENCRYPTION_KEY=
# Required in production. Any long random string: openssl rand -hex 32
# APP_SECRET=

MAIL_DRIVER=log
# RESEND_API_KEY=
# MAIL_DRIVER=smtp (self-hosted mailcow). Port 587 = STARTTLS (SMTP_SECURE=false); 465 = implicit TLS (true).
# SMTP_HOST=mail.chartermission.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=no-reply@chartermission.com
# SMTP_PASS=
MAIL_FROM="Charter Mission <no-reply@chartermission.com>"

STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.uploads
# Cloudflare R2: S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com and S3_REGION=auto.
# The bucket needs a CORS rule allowing PUT (with Content-Type) from the web app's origin, since browsers upload straight to it.
# S3_ENDPOINT=
S3_REGION=auto
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Production must point at a clamd service; without it only a built-in EICAR check runs.
# CLAMAV_HOST=
CLAMAV_PORT=3310
# Video conversion. Defaults to the bundled @ffmpeg-installer binaries, then ffmpeg/ffprobe on the PATH.
# FFMPEG_PATH=
# FFPROBE_PATH=
HIBP_ENABLED=false
RUN_WORKERS=true
DEV_TOOLS=true

# Learning catalogue (Charter Center partner API). Leave unset to use the bundled fixture catalogue.
# CHARTER_CENTER_API_URL=https://charter-center.com/api/partner
# CHARTER_CENTER_API_KEY=
# Course page members are sent to; {id} is the Charter Center course id (confirm with Charter Center).
# CHARTER_CENTER_COURSE_URL=https://charter-center.com/courses/{id}
# Exams: "mock" until Charter Center's student lookup and certificate APIs are live (docs/CHARTER-CENTER-EXAMS-API.md)
CHARTER_CENTER_EXAMS_API=mock
