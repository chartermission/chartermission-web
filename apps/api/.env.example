NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://postgres@localhost:5432/chartermission
REDIS_URL=redis://localhost:6379

WEB_ORIGINS=http://localhost:3000,http://localhost:3001
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
API_PUBLIC_URL=http://localhost:3000/api/v1
# COOKIE_DOMAIN=

# Required in production. 32 random bytes, base64: openssl rand -base64 32
# APP_ENCRYPTION_KEY=
# Required in production. Any long random string: openssl rand -hex 32
# APP_SECRET=

MAIL_DRIVER=log
# RESEND_API_KEY=
MAIL_FROM="Charter Mission <no-reply@chartermission.org>"

STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.uploads
# S3_ENDPOINT=
S3_REGION=auto
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Production must point at a clamd service; without it only a built-in EICAR check runs.
# CLAMAV_HOST=
CLAMAV_PORT=3310
HIBP_ENABLED=false
RUN_WORKERS=true
DEV_TOOLS=true
